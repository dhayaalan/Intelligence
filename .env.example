# Global Platform Environment Configuration
APP_ENV=development
SECRET_KEY=sential-production-ultra-secure-jwt-key-256-bit-signature

# Primary Database (MongoDB Source of Truth)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sential_db

# Message Broker & Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Storage / Evidence Vault
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sential-evidence

# Search & Execution Engine Limits
SEARCH_JOB_TIMEOUT_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=10

# Frontend Environment
VITE_API_URL=http://localhost:8000/api/v1
