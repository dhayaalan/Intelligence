# Global Platform Environment Configuration
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-here

# Super Admin Bootstrap Configuration (Required for initial production setup)
INITIAL_SUPER_ADMIN_EMAIL=superadmin@sential.io
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-a-secure-password-min-12-chars

# Primary Database (MongoDB Source of Truth)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sential_db

# Message Broker & Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Storage / Evidence Vault
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=sential-evidence

# Search & Execution Engine Limits
SEARCH_JOB_TIMEOUT_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=10

# Frontend Environment
VITE_API_URL=http://localhost:8000/api/v1

