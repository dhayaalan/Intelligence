# Global Platform Environment Configuration
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-here

# Super Admin Bootstrap Configuration (Required for initial production setup)
INITIAL_SUPER_ADMIN_EMAIL=superadmin@sential.io
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-a-secure-password-min-12-chars

# Primary Database (MongoDB Source of Truth)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sential_db

# Message Broker & Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Storage / Evidence Vault
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=sential-evidence

# Search & Execution Engine Limits
SEARCH_JOB_TIMEOUT_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=10

# Frontend Environment
VITE_API_URL=http://localhost:8000/api/v1

# Dedicated Relationship Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sential_neo4j_secret
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ----------------------------------------------------------------------------
# OSINT Providers Configuration
# ----------------------------------------------------------------------------
# Shodan: Keyless InternetDB is active by default. Set key for full host census.
SHODAN_API_KEY=

# SpiderFoot: URL of local or remote SpiderFoot daemon (e.g. http://localhost:5001)
SPIDERFOOT_URL=http://localhost:5001

# theHarvester: URL of the theHarvester HTTP worker container
THEHARVESTER_WORKER_URL=http://localhost:5002

# Dynamic Application Security Scanner (OWASP ZAP)
ZAP_API_URL=http://localhost:8091
ZAP_API_KEY=changeme

# ----------------------------------------------------------------------------
# Machine Learning & Media Processing
# ----------------------------------------------------------------------------
# External ML Microservice (Vision / VLM / Face Matching)
ML_SERVICE_URL=
ML_SERVICE_API_KEY=
ML_SERVICE_TIMEOUT_SECONDS=30

# Authorized Video Footage & Media Ingestion Storage Directory
FOOTAGE_UPLOAD_DIR=/tmp/sential_footage


