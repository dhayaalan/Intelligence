APP_ENV=development
SECRET_KEY=sential-production-ultra-secure-jwt-key-256-bit-signature

# Primary Database (MongoDB Source of Truth)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sential_db

# Message Broker & Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Storage / Evidence Vault
STORAGE_DIR=storage/evidence
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sential-evidence

SEARCH_JOB_TIMEOUT_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=10

# External Integration Credentials (Optional)
SHODAN_API_KEY=
SPIDERFOOT_URL=http://localhost:5001
ZAP_API_ENDPOINT=http://localhost:8090
